{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": ".cursor/hooks/fm-primary-turnend-guard.sh"
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/fm-primary-subagent-guard.sh",
        "matcher": "Task"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/fm-primary-cd-guard.sh"
      },
      {
        "command": ".cursor/hooks/fm-primary-arm-guard.sh"
      }
    ]
  }
}
